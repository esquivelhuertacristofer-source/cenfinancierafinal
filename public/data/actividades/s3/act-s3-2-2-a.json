          "label": "Tu tasa de ahorro",
          "type": "calculated",
          "formula": "Math.round(((apoyo_familiar + beca + trabajo) - (renta + transporte + comida + escuela) - (social + suscripciones + antojos)) / Math.max(1, apoyo_familiar + beca + trabajo) * 100)",
