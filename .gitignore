# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# cloudflare (OpenNext + wrangler)
.open-next/
.wrangler/
.wrangler-audit/
.dev.vars

# generated artifacts (credentials PDFs, validation outputs)
output/

# typescript
*.tsbuildinfo
next-env.d.ts
scripts/

# Docs con credenciales — gestionar sólo en variables de entorno, nunca versionar valores reales
docs/CREDENCIALES*.md

# Respaldos y archivos de debug (nunca versionar)
_respaldo-*/
_archivo_debug_*/
_pre-port-backup/
_pre-fix-backup*/
_diagnostico*.log
_build-*.log
build_log.txt
dev-verify.log
*.bak
*.bak2
*.bak3
audit_activities.py
audit_types.py
clean_json.py
find_line.py
find_trailing_commas.py
process_images.py
robust_engine.py
strict_validate.py
validate_json.py

# Taller de video (Remotion + ComfyUI + XTTS). Los insumos pesados se regeneran
# con los scripts de `video-explicativo/`; lo que se versiona son los guiones.
video-explicativo/node_modules/
video-explicativo/out/*
# ...pero el manifiesto de lo subido a R2 SI se versiona. wrangler 4 no tiene
# `r2 object list`, asi que este archivo es el unico inventario del bucket: si se
# pierde, no hay forma de saber que hay arriba sin resubir los sesenta videos.
!video-explicativo/out/.publicado.json
video-explicativo/public/escenas/
video-explicativo/public/audio/
video-explicativo/src/Root.tsx

# Instancias de Epilogue que genera scripts/temario-pdf.py (se rehacen solas)
scripts/.fuentes/
