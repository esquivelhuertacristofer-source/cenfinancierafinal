    {
      "id": "resultado",
      "titulo": "📊 Cómo cierras el mes",
      "descripcion": "El número que decide si estás construyendo o cavando.",
      "campos": [
        {
          "id": "saldo",
          "label": "Lo que te queda al final del mes",
          "type": "calculated",
          "formula": "(apoyo_familiar + beca + trabajo) - (renta + transporte + comida + escuela) - (social + suscripciones + antojos)",
